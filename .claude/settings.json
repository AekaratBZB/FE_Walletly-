{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/sync-plan-code.mjs --hook",
            "timeout": 30,
            "statusMessage": "Syncing plan docs"
          }
        ]
      }
    ]
  }
}
