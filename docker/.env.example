# คัดลอกเป็น docker/.env แล้วใส่ค่าจริง (docker/.env ไม่ถูก commit)
# รหัสผ่านใช้แค่ตัวอักษร + ตัวเลข (ห้ามมี ; ' " $) ยาว 16+ ตัว มีพิมพ์เล็ก พิมพ์ใหญ่ และตัวเลข ตาม policy ของ SQL Server

# ยอมรับ license ของ SQL Server Developer Edition: https://go.microsoft.com/fwlink/?linkid=857698
MSSQL_ACCEPT_EULA=
MSSQL_SA_PASSWORD=
DB_APP_PASSWORD=

# ยาวอย่างน้อย 32 ตัว
JWT_SECRET=

# path ของ BE repo (relative กับโฟลเดอร์ docker/)
BE_DIR=../../BE_wallet_net

WEB_PORT=8080
DB_PORT=14333
